    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catch faultElement="ns9:DocumentFault"
                faultName="ns9:DocumentFault"
                faultVariable="DocumentFault" tibex:xpdlId="dbd33bd4-ed46-4138-8ccd-75d7e86a978b">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link
                                name="DF-Handle-ExceptionToDF-RmDoc" tibex:linkType="SUCCESS"/>
                            <bpws:link name="DF-RmDocToSendHTTPResponse" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="DocFault-Handle-Exception-input"
                                name="DocFault-Handle-Exception"
                                outputVariable="DocFault-Handle-Exception"
                                tibex:xpdlId="2f63dca4-cd24-4dcb-a4e5-6bf7e23160bf"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="DF-Handle-ExceptionToDF-RmDoc"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;urn:ceva:eai:bwce:cfw:doc:exceptionhandler&quot; xmlns:ns2=&quot;urn:ceva:eai:bwce:cfw:doc:faultdetails&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Create-Doc&quot;/>&#xa;    &lt;xsl:param name=&quot;DocumentFault&quot;/>&#xa;    &lt;xsl:template name=&quot;DF-Handle-Exception-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DocumentFault/DocumentId)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$DocumentFault/DocumentId&quot;>&#xa;                        &lt;DocumentID>&#xa;                            &lt;xsl:value-of select=&quot;$DocumentFault/DocumentId&quot;/>&#xa;                        &lt;/DocumentID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Create-Doc/MethodReturnValue&quot;>&#xa;                        &lt;DocumentID>&#xa;                            &lt;xsl:value-of select=&quot;$Create-Doc/MethodReturnValue&quot;/>&#xa;                        &lt;/DocumentID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$DocumentFault/ns2:FaultDetails&quot;/>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="CommonFramework"
                                    subProcessName="CommonCore.Mediation.Utilities.ExceptionHandler.ExceptionHandler" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="DocFault-ClearDoc-input"
                                name="DocFault-ClearDoc"
                                tibex:xpdlId="dfb0de7f-183f-4f79-a349-3b8bd3b59e74"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="DF-Handle-ExceptionToDF-RmDoc"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="DF-RmDocToSendHTTPResponse"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;urn:ceva:eai:bwce:cfw:doc:removedocfromstore&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Err-RmDoc-input&quot; match=&quot;/&quot;>&lt;tns5:Input>&lt;DocumentID>&lt;xsl:value-of select=&quot;'ALL'&quot;/>&lt;/DocumentID>&lt;/tns5:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="CommonFramework"
                                    subProcessName="CommonCore.Mediation.Utilities.Documents.RemoveDocFromStore" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="DocFault-HTTP-Response-input"
                                name="DocFault-HTTP-Response"
                                tibex:xpdlId="2d83c740-3328-4761-80c6-91fb7e2bf987" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="DF-RmDocToSendHTTPResponse"/>
                                </bpws:targets>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/activity/sendhttpresponse/xsd/input+2d83c740-3328-4761-80c6-91fb7e2bf987+ResponseActivityInput&quot; xmlns:ns3=&quot;urn:ceva:eai:bwce:cfw:doc:exceptionhandlerconfig&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DocFault-Handle-Exception&quot;/>&lt;xsl:template name=&quot;DocFault-HTTP-Response-input&quot; match=&quot;/&quot;>&lt;tns6:ResponseActivityInput>&lt;Headers>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($DocFault-Handle-Exception/ns3:properties/SyncResponse)&quot;>&lt;StatusLine>&lt;xsl:value-of select=&quot;concat('HTTP/1.1 ', xsd:string($DocFault-Handle-Exception/ns3:properties/SyncResponse/@code), ' ', $DocFault-Handle-Exception/ns3:properties/SyncResponse)&quot;/>&lt;/StatusLine>&lt;/xsl:when>&lt;xsl:when test=&quot;$DocFault-Handle-Exception/ns3:properties/isRecoverable&quot;>&lt;StatusLine>&lt;xsl:value-of select=&quot;'HTTP/1.1 500 Internal Server Error'&quot;/>&lt;/StatusLine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;StatusLine>&lt;xsl:value-of select=&quot;'HTTP/1.1 400 Bad Request Error'&quot;/>&lt;/StatusLine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Headers>&lt;/tns6:ResponseActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.http.sendHTTPResponse"
                                    version="6.0.0.20132205"
                                    xmlns:ResponseActivityInput="http://tns.tibco.com/bw/activity/sendhttpresponse/xsd/input+2d83c740-3328-4761-80c6-91fb7e2bf987+ResponseActivityInput"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:http="http://ns.tibco.com/bw/palette/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/http#//SendHTTPResponse"/>
                                    <value
                                    closeConnection="true"
                                    flushResponse="true"
                                    inputHeadersQName="ResponseActivityInput:headersType"
                                    replyFor="HTTPReceiver" xsi:type="http:SendHTTPResponse"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catch>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="0eb606d5-5e83-4403-a12d-731754ba842f">
                <bpws:scope name="scope2">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link
                                name="handle-ExceptionToCallProcess" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="All-RmDocToSendHTTPResponse" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="AllFault-Handle-Exception-input"
                                name="AllFault-Handle-Exception"
                                outputVariable="AllFault-Handle-Exception"
                                tibex:xpdlId="c2ed6ca9-b9f3-49db-90c7-da76d21934f3"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="handle-ExceptionToCallProcess"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;urn:ceva:eai:bwce:cfw:doc:exceptionhandler&quot; xmlns:ns2=&quot;urn:ceva:eai:bwce:cfw:doc:faultdetails&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Create-Doc&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;handle-Exception-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;xsl:if test=&quot;$Create-Doc/MethodReturnValue&quot;>&#xa;                &lt;DocumentID>&#xa;                    &lt;xsl:value-of select=&quot;$Create-Doc/MethodReturnValue&quot;/>&#xa;                &lt;/DocumentID>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns2:FaultDetails>&#xa;                &lt;ErrorReport>&#xa;                    &lt;xsl:copy-of select=&quot;$_error/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$_error/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$_error/node()&quot;/>&#xa;                &lt;/ErrorReport>&#xa;            &lt;/ns2:FaultDetails>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="CommonFramework"
                                    subProcessName="CommonCore.Mediation.Utilities.ExceptionHandler.ExceptionHandler" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="AllFault-ClearDoc-input"
                                name="AllFault-ClearDoc"
                                tibex:xpdlId="70b880e4-f0ec-4a03-b97e-e5d4b34b9d80"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="handle-ExceptionToCallProcess"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="All-RmDocToSendHTTPResponse"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;urn:ceva:eai:bwce:cfw:doc:removedocfromstore&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Err-RmDoc-input&quot; match=&quot;/&quot;>&lt;tns5:Input>&lt;DocumentID>&lt;xsl:value-of select=&quot;'ALL'&quot;/>&lt;/DocumentID>&lt;/tns5:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="CommonFramework"
                                    subProcessName="CommonCore.Mediation.Utilities.Documents.RemoveDocFromStore" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="AllFault-HTTP-Response-input"
                                name="AllFault-HTTP-Response"
                                tibex:xpdlId="360b24be-403c-4555-94cc-95138e834963" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="All-RmDocToSendHTTPResponse"/>
                                </bpws:targets>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://tns.tibco.com/bw/activity/sendhttpresponse/xsd/input+360b24be-403c-4555-94cc-95138e834963+ResponseActivityInput&quot; xmlns:ns3=&quot;urn:ceva:eai:bwce:cfw:doc:exceptionhandlerconfig&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AllFault-Handle-Exception&quot;/>&lt;xsl:template name=&quot;AllFault-HTTP-Response-input&quot; match=&quot;/&quot;>&lt;tns7:ResponseActivityInput>&lt;Headers>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AllFault-Handle-Exception/ns3:properties/SyncResponse)&quot;>&lt;StatusLine>&lt;xsl:value-of select=&quot;concat('HTTP/1.1 ',xsd:string($AllFault-Handle-Exception/ns3:properties/SyncResponse/@code),' ',$AllFault-Handle-Exception/ns3:properties/SyncResponse)&quot;/>&lt;/StatusLine>&lt;/xsl:when>&lt;xsl:when test=&quot;$AllFault-Handle-Exception/ns3:properties/isRecoverable&quot;>&lt;StatusLine>&lt;xsl:value-of select=&quot;'HTTP/1.1 500 Internal Server Error'&quot;/>&lt;/StatusLine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;StatusLine>&lt;xsl:value-of select=&quot;'HTTP/1.1 400 Bad Request Error'&quot;/>&lt;/StatusLine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Headers>&lt;/tns7:ResponseActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.http.sendHTTPResponse"
                                    version="6.0.0.20132205"
                                    xmlns:ResponseActivityInput="http://tns.tibco.com/bw/activity/sendhttpresponse/xsd/input+360b24be-403c-4555-94cc-95138e834963+ResponseActivityInput"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:http="http://ns.tibco.com/bw/palette/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/http#//SendHTTPResponse"/>
                                    <value
                                    closeConnection="true"
                                    flushResponse="true"
                                    inputHeadersQName="ResponseActivityInput:headersType"
                                    replyFor="HTTPReceiver" xsi:type="http:SendHTTPResponse"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="HTTPReceiverToJavaInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="CreateDocToSubmitDocument" tibex:linkType="SUCCESS"/>
                <bpws:link name="SubmitDocumentToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="InvokeProcessRouteToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="RmDocToSendHTTPResponse" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60"
                    governedObjectTypes="BWHttpService"
                    name="HTTPReceiver"
                    tibex:xpdlId="07f4b45e-a6ba-42ca-a1c3-4b101c6d2244"
                    variable="HTTPReceiver" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="HTTPReceiverToJavaInvoke"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.http.HTTPReceiver"
                            version="6.0.0.20132205"
                            xmlns:ActivityOutputType="http://www.tibco.com/namespaces/tnt/plugins/httpreceiver+07f4b45e-a6ba-42ca-a1c3-4b101c6d2244+ActivityOutputType"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:http="http://ns.tibco.com/bw/palette/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="contextPath" processProperty="receiveContextPath"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="endpointUri" processProperty="receivePathSpec"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/http#//HTTPReceiver"/>
                                    <value customId=""
                                    defaultEncoding="UTF8"
                                    httpConnection="httpConnectorResource"
                                    outputHeadersQName="ActivityOutputType:headersType"
                                    outputStyle="Binary"
                                    sequencingKey=""
                                    writeToFile="true" xsi:type="http:HTTPReceiver">
                                    <writeToFilePolicy createNonExistingDirectories="true">
                                    <modulePropertyBindings
                                    bindingType="moduleProperty"
                                    configProperty="diskoverflowpath" eAttributeName="directory"/>
                                    <modulePropertyBindings
                                    bindingType="moduleProperty"
                                    configProperty="diskoverflowlimitbytes" eAttributeName="thresholdDataSize"/>
                                    </writeToFilePolicy>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Create-Doc-input" name="Create-Doc"
                    outputVariable="Create-Doc"
                    tibex:xpdlId="734070f4-cc4c-409a-b148-f4444509a5f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="HTTPReceiverToJavaInvoke"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CreateDocToSubmitDocument"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+734070f4-cc4c-409a-b148-f4444509a5f3+JavaInvokeActivityInput&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:strutils=&quot;urn:ceva:eai:bwce:cfw:doc:xpathfnc:strutils&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;HTTPReceiver&quot;/>&lt;xsl:template name=&quot;Create-Doc-input&quot; match=&quot;/&quot;>&lt;tns:JavaInvokeActivityInput>&lt;MethodParameters>&lt;jobID>&lt;xsl:value-of select=&quot;$_processContext/JobId&quot;/>&lt;/jobID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($HTTPReceiver/BinaryContent)&quot;>&lt;data>&lt;xsl:value-of select=&quot;$HTTPReceiver/BinaryContent&quot;/>&lt;/data>&lt;properties>&lt;xsl:value-of select=&quot;  strutils:getDocPropFromHeaderString('DocumentIsReference', 'false')&quot;/>&lt;/properties>&lt;/xsl:when>&lt;xsl:otherwise>&lt;data>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64($HTTPReceiver/FileName))&quot;/>&lt;/data>&lt;properties>&lt;xsl:value-of select=&quot;  strutils:getDocPropFromHeaderString('DocumentIsReference', 'true')&quot;/>&lt;/properties>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$HTTPReceiver/DynamicHeaders/Header&quot;>&lt;properties>&lt;xsl:value-of select=&quot;  strutils:getDocPropFromHeaderString(Name, Value)&quot;/>&lt;/properties>&lt;/xsl:for-each>&lt;/MethodParameters>&lt;/tns:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.java.javamethod"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:java="http://ns.tibco.com/bw/palette/java" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/java#//JavaMethod"/>
                                    <value
                                    className="com.ceva.eai.bwce.generic.cfw.model.DocumentManagedFactory"
                                    isNew="true"
                                    isNewActivity="true"
                                    javaGlobalInstance="DocManagerGlobalInstance"
                                    methodName="createDocument"
                                    methodReturn="string" xsi:type="java:JavaMethod">
                                    <exceptionTypes>java.lang.Exception</exceptionTypes>
                                    <methodParameter
                                    paramName="jobID" paramType="string"/>
                                    <methodParameter
                                    paramName="data" paramType="byte[]"/>
                                    <methodParameter
                                    paramName="properties" paramType="string[]"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Submit-Document-input"
                    name="Submit-Document"
                    outputVariable="Submit-Document"
                    tibex:xpdlId="090dc93d-308e-4834-b33d-8652eeefe693"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CreateDocToSubmitDocument"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SubmitDocumentToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;urn:ceva:eai:bwce:cfw:doc:submitdocument&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Create-Doc&quot;/>&lt;xsl:param name=&quot;HTTPReceiver&quot;/>&lt;xsl:template name=&quot;Submit-Document-input&quot; match=&quot;/&quot;>&lt;xsl:variable name=&quot;varProps&quot; select=&quot;$HTTPReceiver/DynamicHeaders/Header[contains(lower-case(Name), 'document')]&quot;/>&lt;xsl:variable name=&quot;varPropKeys&quot; select=&quot;for $field in $varProps return concat($field/Name,':', $field/Value)&quot;/>&lt;xsl:variable name=&quot;varKeys&quot; select=&quot;string-join($varPropKeys,',')&quot;/>&lt;tns2:Input>&lt;DocumentID>&lt;xsl:value-of select=&quot;$Create-Doc/MethodReturnValue&quot;/>&lt;/DocumentID>&lt;Log>&lt;LogCategory>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//CommonFramework///CommonCore/Properties/LogCategory/Technical&amp;quot;)&quot;/>&lt;/LogCategory>&lt;LogLevel>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//CommonFramework///CommonCore/Properties/LogLevel/Debug&amp;quot;)&quot;/>&lt;/LogLevel>&lt;LogCode>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//CommonFramework///CommonCore/Properties/LogCode/Event&amp;quot;)&quot;/>&lt;/LogCode>&lt;LogType>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;//CommonFramework///CommonCore/Properties/LogType/Transfer&amp;quot;)&quot;/>&lt;/LogType>&lt;LogMessage>&lt;xsl:value-of select=&quot;concat('Received document  from destination:', $HTTPReceiver/RequestURI)&quot;/>&lt;/LogMessage>&lt;LogTrace>&lt;xsl:value-of select=&quot;concat('Properties: ', $varKeys)&quot;/>&lt;/LogTrace>&lt;/Log>&lt;/tns2:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess moduleRef="CommonFramework"
                        subProcessName="CommonCore.Mediation.Utilities.Log.SubmitDocument" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
