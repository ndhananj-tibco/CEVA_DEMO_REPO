            tibex:propertySource="//CommonFramework///CommonCore/Docs/diskOverflowLimitBytes" type="xsd:long"/>
        <bpws:variable element="ns4:Input" name="Submit-Document-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Output" name="Submit-Document" sca-bpel:internal="true"/>
